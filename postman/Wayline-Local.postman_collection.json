{
  "info": {
    "name": "Wayline \u2014 Local development",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run backend on 8088 and seed-demo.py first. Run requests in order. Cookie jar must stay enabled. Each mutation fetches fresh CSRF automatically, including after login rotates the session. Fictional local accounts only. Run Confirm again before Cancel to verify idempotency."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088"
    },
    {
      "key": "tripId",
      "value": ""
    },
    {
      "key": "seatNo",
      "value": "A1"
    },
    {
      "key": "holdId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "bookingKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (![\"GET\", \"HEAD\", \"OPTIONS\"].includes(pm.request.method)) {",
          "  pm.sendRequest(pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/auth/csrf\", function (error, response) {",
          "    if (error || response.code !== 200) throw new Error(\"CSRF request failed; start the backend first.\");",
          "    const csrf = response.json();",
          "    pm.request.headers.upsert({ key: csrf.headerName, value: csrf.token });",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Backend health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sign in as passenger",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"passenger.demo@example.test\",\n  \"password\": \"DemoPass123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
    {

    },
    {
      "name": "04 Find trips (seed demo first)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/trips"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const trips=pm.response.json().items; if(trips.length) pm.collectionVariables.set(\"tripId\",trips[0].id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Read seats",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/seats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const seat=pm.response.json().find(s=>s.status===\"AVAILABLE\"); if(seat) pm.collectionVariables.set(\"seatNo\",seat.label);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Hold selected seat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/holds",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"seatNos\": [\n    \"{{seatNo}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
              "pm.collectionVariables.set(\"holdId\",pm.response.json().id); pm.collectionVariables.set(\"bookingKey\",pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Confirm reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{bookingKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"holdId\": \"{{holdId}}\",\n  \"contactName\": \"Postman Demo\",\n  \"contactEmail\": \"passenger.demo@example.test\",\n  \"contactPhone\": \"000-POSTMAN\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "pm.collectionVariables.set(\"bookingId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
